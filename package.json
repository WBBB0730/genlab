{
  "name": "genhub",
  "type": "module",
  "version": "0.1.0",
  "description": "给本地 agent 用的 AI 媒体生成命令行工具（kie.ai），产物与完整生成记录保存在本机",
  "author": "WBBB",
  "license": "MIT",
  "homepage": "https://github.com/WBBB0730/genhub-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WBBB0730/genhub-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "genhub": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.5",
    "@clack/prompts": "^1.8.1",
    "ajv": "^8.20.0",
    "ajv-i18n": "^4.2.0",
    "commander": "^15.0.0",
    "file-type": "^22.3.0",
    "image-size": "^2.0.4",
    "music-metadata": "^12.3.4",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
